---
import "../styles/global.css";
// Theme preset. Swap this one line to rebrand the site.
// Options: editorial | startup | agency | boutique | brutalist
import "../styles/themes/startup.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { reader } from "../lib/keystatic";

interface Props {
  title?: string;
  description?: string;
  hideChrome?: boolean;
  /**
   * Optional Google Fonts (or any external stylesheet) URL. When set,
   * the layout emits the standard preconnect + stylesheet tags in the
   * head. Pair this with a matching `--font-body` / `--font-display`
   * in your active theme preset.
   */
  fontsHref?: string | null;
}

const settings = await reader.singletons.siteSettings.read();
const defaultTitle = settings?.siteName || "Your Site";
const defaultDescription = settings?.description || "A fast, git-based Astro site with a built-in CMS.";

const {
  title = defaultTitle,
  description = defaultDescription,
  hideChrome = false,
  fontsHref = null,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    {fontsHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href={fontsHref} rel="stylesheet" />
      </>
    )}

    <slot name="head" />

    {/*
      Add analytics, pixel, or tag-manager snippets here (Google Tag Manager,
      Plausible, Fathom, Rewardful, etc). Leaving this blank out of the box
      keeps the starter tracker-free.
    */}
  </head>
  <body class="min-h-screen">
    {!hideChrome && <Header />}
    <slot />
    {!hideChrome && <Footer />}
  </body>
</html>

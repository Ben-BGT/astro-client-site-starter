---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  hideChrome?: boolean;
}

const {
  title = "Your Site",
  description = "A fast, git-based Astro site with a built-in CMS.",
  hideChrome = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <slot name="head" />

    {/*
      Add analytics, pixel, or tag-manager snippets here (Google Tag Manager,
      Plausible, Fathom, Rewardful, etc). Leaving this blank out of the box
      keeps the starter tracker-free.
    */}
  </head>
  <body class="min-h-screen">
    {!hideChrome && <Header />}
    <slot />
    {!hideChrome && <Footer />}
  </body>
</html>

---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

// Landing page template. Conversion-focused single-page layout.
// Everything except testimonials is hardcoded — a member (or client) replaces
// the copy in this file directly. Testimonials pull from the CMS so swapping
// them in/out requires no code changes.

const testimonials = (await getCollection("testimonials")).slice(0, 3);

const problems = [
  "The site looks like a template from 2016.",
  "Nobody on the team can update it without breaking it.",
  "Pages load so slowly prospects bounce before the hero finishes rendering.",
];

const solutions = [
  {
    title: "A brand that finally fits",
    text: "Positioning and messaging that sounds like your best sales call. Design that reflects the quality of the work.",
  },
  {
    title: "A CMS anyone can use",
    text: "Edit any page in the browser. Changes save straight to git. No dev, no downtime, no support tickets.",
  },
  {
    title: "A site that loads instantly",
    text: "Static-first architecture. Sub-second page loads. Passes every Core Web Vitals check out of the box.",
  },
];

const features = [
  { title: "Fixed scope", text: "You know the price before we start. No surprise invoices." },
  { title: "Two week build", text: "From kickoff to live site in ten working days." },
  { title: "Full ownership", text: "The domain, repo, and hosting all sit in your name." },
  { title: "Training included", text: "A 30 minute video walkthrough plus a one-page cheat sheet." },
];

const faqs = [
  {
    q: "Do I own the code and content?",
    a: "Yes. Everything sits in a git repo in your GitHub account. Hosting is in your name. If we ever part ways, the whole site comes with you.",
  },
  {
    q: "How do edits work?",
    a: "You log in at /keystatic with your GitHub account and edit pages in a friendly admin UI. Each save commits to git and the site redeploys automatically.",
  },
  {
    q: "What if I need a custom feature later?",
    a: "The stack is extensible. Need a booking widget, a member portal, a CRM sync? We scope it as a separate project.",
  },
  {
    q: "What's the catch?",
    a: "None. The only ongoing cost is hosting (typically $0-20/month depending on traffic) and a domain name.",
  },
];
---

<Layout title="Websites that actually work" description="Fast, editable, fixed-price sites built in two weeks.">
  <section class="border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-28 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-4">Fixed price. Two week build.</p>
      <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl lg:text-6xl leading-tight">
        Websites that actually work.
      </h1>
      <p class="mt-6 text-lg text-muted-foreground max-w-2xl mx-auto">
        Fast. Editable. Fully yours. Launch in two weeks with a site your team can update without a developer.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact"
          class="inline-flex items-center justify-center bg-primary px-6 py-3 text-base font-semibold text-primary-foreground hover:bg-primary-hover transition-colors w-full sm:w-auto"
          style="border-radius: var(--radius-md)"
        >
          Book a 20 minute call
        </a>
        <a
          href="/pricing"
          class="inline-flex items-center justify-center border border-border px-6 py-3 text-base font-semibold text-foreground hover:border-primary transition-colors w-full sm:w-auto"
          style="border-radius: var(--radius-md)"
        >
          See pricing
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-muted border-b border-border">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3 text-center">The problem</p>
      <h2 class="text-3xl font-semibold tracking-tight text-foreground text-center">Three things kill most small business websites</h2>
      <ul class="mt-10 space-y-4">
        {problems.map((p) => (
          <li class="flex items-start gap-3 bg-background border border-border p-5" style="border-radius: var(--radius-md)">
            <span class="text-primary font-semibold">✗</span>
            <span class="text-foreground">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-16 sm:py-20 border-b border-border">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3 text-center">The fix</p>
      <h2 class="text-3xl font-semibold tracking-tight text-foreground text-center">A site that fixes all three at once</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {solutions.map((s) => (
          <div class="bg-background border border-border p-6" style="border-radius: var(--radius-md)">
            <h3 class="text-lg font-semibold text-foreground">{s.title}</h3>
            <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-muted border-b border-border">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3 text-center">What you get</p>
      <h2 class="text-3xl font-semibold tracking-tight text-foreground text-center">Everything included, nothing hidden</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {features.map((f) => (
          <div class="bg-background border border-border p-6" style="border-radius: var(--radius-md)">
            <h3 class="text-base font-semibold text-foreground">{f.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="py-16 sm:py-20 border-b border-border">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3 text-center">Social proof</p>
        <h2 class="text-3xl font-semibold tracking-tight text-foreground text-center">What clients say</h2>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="bg-background border border-border p-6" style="border-radius: var(--radius-md)">
              <blockquote class="text-sm text-foreground leading-relaxed">&ldquo;{t.data.quote}&rdquo;</blockquote>
              <figcaption class="mt-4 text-xs text-muted-foreground">
                <span class="font-semibold text-foreground">{t.data.author}</span>
                {t.data.role && <span>, {t.data.role}</span>}
                {t.data.company && <span> &middot; {t.data.company}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16 sm:py-20 bg-muted border-b border-border">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">Pricing</p>
      <h2 class="text-3xl font-semibold tracking-tight text-foreground">One price. No surprises.</h2>
      <p class="mt-4 text-lg text-muted-foreground">
        Three fixed tiers. You know exactly what you're paying before we start.
      </p>
      <a
        href="/pricing"
        class="mt-8 inline-flex items-center justify-center bg-primary px-6 py-3 text-base font-semibold text-primary-foreground hover:bg-primary-hover transition-colors"
        style="border-radius: var(--radius-md)"
      >
        See the tiers
      </a>
    </div>
  </section>

  <section class="py-16 sm:py-20 border-b border-border">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3 text-center">Questions</p>
      <h2 class="text-3xl font-semibold tracking-tight text-foreground text-center">Things people ask</h2>
      <dl class="mt-12 space-y-6">
        {faqs.map((f) => (
          <div class="bg-background border border-border p-6" style="border-radius: var(--radius-md)">
            <dt class="text-base font-semibold text-foreground">{f.q}</dt>
            <dd class="mt-2 text-sm text-muted-foreground leading-relaxed">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
        Ready for a site that works?
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        20 minutes on a call. No pitch. If we're not a fit, we'll tell you on the call.
      </p>
      <div class="mt-8">
        <a
          href="/contact"
          class="inline-flex items-center justify-center bg-primary px-6 py-3 text-base font-semibold text-primary-foreground hover:bg-primary-hover transition-colors"
          style="border-radius: var(--radius-md)"
        >
          Book the call
        </a>
      </div>
    </div>
  </section>
</Layout>

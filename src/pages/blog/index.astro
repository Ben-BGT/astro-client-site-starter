---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout title="Blog — Your Site" description="Posts, notes, and updates.">
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Your Site Blog" href="/rss.xml" />
  </Fragment>
  <section class="mx-auto max-w-5xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="mb-12">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">Blog</p>
      <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">Latest posts</h1>
      <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
        Thoughts, updates, and occasional notes. Edit these posts at <code class="text-primary">/keystatic</code>.
      </p>
    </div>

    {posts.length === 0 ? (
      <p class="text-muted-foreground">No posts yet. Publish one via <code class="text-primary">/keystatic</code>.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group block border border-border p-6 hover:border-primary transition-colors">
            {post.data.cover && (
              <img src={post.data.cover} alt={post.data.title} class="w-full h-40 object-cover mb-4" />
            )}
            <time class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              {new Date(post.data.date).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
            </time>
            <h2 class="mt-2 text-xl font-semibold text-foreground group-hover:text-primary transition-colors">{post.data.title}</h2>
            {post.data.excerpt && <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{post.data.excerpt}</p>}
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>

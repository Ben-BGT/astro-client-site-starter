---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Services" description="What I do, and how I can help.">
  <section class="mx-auto max-w-5xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="mb-12">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">Services</p>
      <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">What I do</h1>
      <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
        Short, focused engagements with clear outcomes. Edit this copy in <code class="text-primary">/keystatic</code>.
      </p>
    </div>

    {services.length === 0 ? (
      <p class="text-muted-foreground">No services yet. Add one in <code class="text-primary">/keystatic</code>.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <a
            href={`/services/${service.id}`}
            class="group block bg-background border border-border p-6 hover:border-primary transition-colors flex flex-col"
            style="border-radius: var(--radius-md)"
          >
            {service.data.icon && (
              <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">{service.data.icon}</p>
            )}
            <h2 class="text-xl font-semibold text-foreground group-hover:text-primary">{service.data.title}</h2>
            {service.data.summary && (
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed flex-1">{service.data.summary}</p>
            )}
            <span class="mt-4 text-sm font-semibold text-primary group-hover:underline">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>

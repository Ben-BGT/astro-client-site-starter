---
/*
  TODO (member extensions): Swap the mailto: for a real form. Good options:
  - Tally (free, no code): embed an iframe.
  - Netlify Forms (free tier on Netlify): add `data-netlify="true"` to a <form>.
  - Formspree / Basin: point <form action="..."> at the endpoint.
  - Resend + an Astro API route (opt out of prerender with
    `export const prerender = false;`) for full control.

  Whichever you pick, keep the layout and heading so the page still reads like
  part of the site. Consider adding a honeypot field and a reCAPTCHA/Turnstile
  challenge to knock back bot spam.
*/
import Layout from "../layouts/Layout.astro";
import { reader } from "../lib/keystatic";

const settings = await reader.singletons.siteSettings.read();
const email = settings?.contactEmail || "hello@example.com";
---

<Layout title="Contact" description="Get in touch.">
  <section class="mx-auto max-w-3xl px-6 py-16 lg:px-8 lg:py-24">
    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">Contact</p>
    <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">Say hello.</h1>
    <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
      The fastest way to reach us is email. We read everything that lands in the inbox and reply within a couple of business days.
    </p>
    <div class="mt-10">
      <a
        href={`mailto:${email}`}
        class="inline-flex items-center justify-center bg-primary px-6 py-3 text-base font-semibold text-primary-foreground hover:bg-primary-hover transition-colors"
        style="border-radius: var(--radius-md)"
      >
        {email}
      </a>
    </div>
    <p class="mt-8 text-sm text-muted-foreground">
      Prefer a form? Swap this page for your form provider (Tally, Netlify Forms, Formspree) and keep the layout the same. Edit the contact email in <code class="text-primary">/keystatic</code> under Site settings.
    </p>
  </section>
</Layout>

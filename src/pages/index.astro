---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import HeroLeftAligned from "../components/heroes/HeroLeftAligned.astro";
import HeroCentered from "../components/heroes/HeroCentered.astro";
import HeroSplitWithImage from "../components/heroes/HeroSplitWithImage.astro";
import HeroDarkBold from "../components/heroes/HeroDarkBold.astro";
import { reader } from "../lib/keystatic";

const home = await reader.singletons.homepage.read();
const settings = await reader.singletons.siteSettings.read();

const heroOverline = home?.heroOverline || "Welcome";
const heroHeadline = home?.heroHeadline || "A simple, fast site you actually own.";
const heroSubhead = home?.heroSubhead || "";
const heroCtaText = home?.heroCtaText || "Read more";
const heroCtaUrl = home?.heroCtaUrl || "/blog";
const heroImage = home?.heroImage || null;
const featuredTitle = home?.featuredSectionTitle || "What I do";
const featuredText = home?.featuredSectionText || "";

const heroVariant = settings?.design?.homepageHeroVariant || "left-aligned";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const featuredTestimonials = (await getCollection("testimonials")).filter((t) => t.data.featured);

const title = settings?.siteName || "Your Site";
const description = settings?.description;
---

<Layout title={title} description={description}>
  {heroVariant === "centered" && (
    <HeroCentered
      overline={heroOverline}
      headline={heroHeadline}
      subhead={heroSubhead}
      ctaText={heroCtaText}
      ctaUrl={heroCtaUrl}
    />
  )}
  {heroVariant === "split-with-image" && (
    <HeroSplitWithImage
      overline={heroOverline}
      headline={heroHeadline}
      subhead={heroSubhead}
      ctaText={heroCtaText}
      ctaUrl={heroCtaUrl}
      heroImage={heroImage}
      imageAlt={heroHeadline}
    />
  )}
  {heroVariant === "dark-bold" && (
    <HeroDarkBold
      overline={heroOverline}
      headline={heroHeadline}
      subhead={heroSubhead}
      ctaText={heroCtaText}
      ctaUrl={heroCtaUrl}
    />
  )}
  {(heroVariant !== "centered" && heroVariant !== "split-with-image" && heroVariant !== "dark-bold") && (
    <HeroLeftAligned
      overline={heroOverline}
      headline={heroHeadline}
      subhead={heroSubhead}
      ctaText={heroCtaText}
      ctaUrl={heroCtaUrl}
    />
  )}

  {services.length > 0 && (
    <section class="py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <SectionHeading
          overline="Services"
          title={featuredTitle}
          description={featuredText}
          align="center"
        />
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <a
              href={`/services/${service.id}`}
              class="group block bg-background border border-border p-6 hover:border-primary transition-colors"
              style="border-radius: var(--radius-md)"
            >
              {service.data.icon && (
                <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">{service.data.icon}</p>
              )}
              <h3 class="text-lg font-semibold text-foreground group-hover:text-primary">{service.data.title}</h3>
              {service.data.summary && (
                <p class="mt-2 text-sm text-muted-foreground">{service.data.summary}</p>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {featuredTestimonials.length > 0 && (
    <section class="py-16 sm:py-20 bg-muted border-t border-border">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <SectionHeading overline="What clients say" title="Words from the people I've worked with" align="center" />
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {featuredTestimonials.slice(0, 2).map((t) => (
            <figure class="bg-background border border-border p-6" style="border-radius: var(--radius-md)">
              <blockquote class="text-base text-foreground leading-relaxed">&ldquo;{t.data.quote}&rdquo;</blockquote>
              <figcaption class="mt-4 text-sm text-muted-foreground">
                <span class="font-semibold text-foreground">{t.data.author}</span>
                {t.data.role && <span>, {t.data.role}</span>}
                {t.data.company && <span> &middot; {t.data.company}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16 sm:py-20 border-t border-border">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
        Ready to get started?
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        A 20 minute call is the fastest way to find out if we're a fit.
      </p>
      <div class="mt-8">
        <a
          href="/contact"
          class="inline-flex items-center justify-center bg-primary px-6 py-3 text-base font-semibold text-primary-foreground hover:bg-primary-hover transition-colors"
          style="border-radius: var(--radius-md)"
        >
          Book a call
        </a>
      </div>
    </div>
  </section>
</Layout>

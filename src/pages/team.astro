---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Team" description="The people behind the work.">
  <section class="mx-auto max-w-5xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="mb-12">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">Team</p>
      <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">The people behind the work</h1>
      <p class="mt-4 text-lg text-muted-foreground max-w-2xl">
        Small team. Real humans. Edit this page in <code class="text-primary">/keystatic</code>.
      </p>
    </div>

    {team.length === 0 ? (
      <p class="text-muted-foreground">No team members yet. Add one in <code class="text-primary">/keystatic</code>.</p>
    ) : (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((member) => (
          <div class="bg-background border border-border p-6" style="border-radius: 2px">
            {member.data.photo ? (
              <img
                src={member.data.photo}
                alt={member.data.name}
                class="w-24 h-24 object-cover mb-4"
                style="border-radius: 2px"
              />
            ) : (
              <div
                class="w-24 h-24 bg-muted flex items-center justify-center text-2xl font-semibold text-muted-foreground mb-4"
                style="border-radius: 2px"
              >
                {member.data.name.split(" ").map((n) => n[0]).join("").slice(0, 2)}
              </div>
            )}
            <h2 class="text-lg font-semibold text-foreground">{member.data.name}</h2>
            {member.data.role && <p class="text-sm text-primary font-medium">{member.data.role}</p>}
            {member.data.bio && <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{member.data.bio}</p>}
            {member.data.links.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-3">
                {member.data.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      class="text-xs font-semibold uppercase tracking-wider text-muted-foreground hover:text-primary"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>

---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

// aboutPage is a Keystatic singleton stored at src/content/pages/about.mdoc.
// We read it through the `pages` content collection so Astro's native markdoc
// pipeline renders it, matching how blog posts and services work.
const about = await getEntry("pages", "about");
const title = about?.data.title ?? "About";
const tagline = about?.data.tagline;

let Content;
if (about) {
  const rendered = await render(about);
  Content = rendered.Content;
}
---

<Layout title={title} description={tagline}>
  <section class="mx-auto max-w-3xl px-6 py-16 lg:px-8 lg:py-24">
    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">About</p>
    <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">{title}</h1>
    {tagline && <p class="mt-6 text-lg text-muted-foreground leading-relaxed">{tagline}</p>}
    {Content && (
      <div class="mt-10 prose prose-lg max-w-none prose-headings:font-semibold prose-headings:text-foreground prose-p:text-foreground prose-a:text-primary prose-strong:text-foreground">
        <Content />
      </div>
    )}
  </section>
</Layout>

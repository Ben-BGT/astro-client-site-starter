---
/*
  Footer dispatcher. Reads siteSettings.design.footerVariant and
  renders the matching variant. Variants live in ./footers/*.astro.
*/
import { reader } from "../lib/keystatic";
import FooterSimple from "./footers/FooterSimple.astro";
import FooterColumns from "./footers/FooterColumns.astro";
import FooterMinimal from "./footers/FooterMinimal.astro";

const settings = await reader.singletons.siteSettings.read();
const variant = settings?.design?.footerVariant || "simple";
---

{variant === "columns" && <FooterColumns />}
{variant === "minimal" && <FooterMinimal />}
{(variant !== "columns" && variant !== "minimal") && <FooterSimple />}

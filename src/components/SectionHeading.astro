---
interface Props {
  overline?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { overline, title, description, align = "left" } = Astro.props;
---

<div class={align === "center" ? "text-center" : ""}>
  {overline && (
    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">{overline}</p>
  )}
  <h2 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">{title}</h2>
  {description && (
    <p class="mt-4 text-lg text-muted-foreground max-w-2xl">{description}</p>
  )}
</div>

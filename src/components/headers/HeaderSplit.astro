---
/*
  Split header. Nav items split across two sides of a centered site name.
  Good for premium / luxury / editorial brands.
*/
import { reader } from "../../lib/keystatic";

const settings = await reader.singletons.siteSettings.read();
const siteName = settings?.siteName || "Your Site";

// First three items go left of the logo, last three go right.
const leftNav = [
  { name: "Services", href: "/services" },
  { name: "Team", href: "/team" },
  { name: "About", href: "/about" },
];
const rightNav = [
  { name: "Blog", href: "/blog" },
  { name: "Case studies", href: "/services" },
  { name: "Contact", href: "/contact" },
];
const mobileNav = [...leftNav, ...rightNav];
---

<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur">
  <nav class="mx-auto max-w-7xl px-6 lg:px-8 py-4" aria-label="Global">
    <div class="flex items-center justify-between lg:grid lg:grid-cols-[1fr_auto_1fr] lg:gap-8 lg:items-center">
      <div class="hidden lg:flex gap-x-6 justify-start">
        {leftNav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-muted-foreground transition-colors hover:text-primary">
            {item.name}
          </a>
        ))}
      </div>

      <a href="/" class="flex items-center gap-2 lg:justify-center">
        <img src="/favicon.svg" alt={siteName} width="28" height="28" class="h-7 w-7" />
        <span class="text-xl font-semibold tracking-tight text-foreground whitespace-nowrap">{siteName}</span>
      </a>

      <div class="hidden lg:flex gap-x-6 justify-end">
        {rightNav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-muted-foreground transition-colors hover:text-primary">
            {item.name}
          </a>
        ))}
      </div>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex items-center justify-center p-2.5 text-foreground lg:hidden"
        style="border-radius: var(--radius-md)"
        aria-label="Open main menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden lg:hidden">
    <div class="fixed inset-0 z-[100] bg-black/20" id="mobile-menu-backdrop"></div>
    <div class="fixed inset-y-0 right-0 z-[110] w-full overflow-y-auto bg-background px-6 py-6 sm:max-w-sm sm:ring-1 sm:ring-border">
      <div class="flex items-center justify-between">
        <span class="text-xl font-semibold tracking-tight text-foreground">{siteName}</span>
        <button type="button" id="mobile-menu-close" class="p-2.5 text-foreground" style="border-radius: var(--radius-md)" aria-label="Close menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div class="mt-6 space-y-2">
        {mobileNav.map((item) => (
          <a href={item.href} class="block px-3 py-2 text-base font-medium text-foreground hover:bg-muted" style="border-radius: var(--radius-md)">
            {item.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const close = document.getElementById('mobile-menu-close');
  const open = () => menu?.classList.remove('hidden');
  const shut = () => menu?.classList.add('hidden');
  toggle?.addEventListener('click', open);
  backdrop?.addEventListener('click', shut);
  close?.addEventListener('click', shut);
</script>

---
/*
  Logo cloud. Grayscale by default, subtle hover to full colour. Used to
  show client logos, press coverage, or partner badges.
*/
interface Logo {
  name?: string;
  image?: string | null;
}

interface Props {
  title?: string;
  logos?: Logo[];
}

const { title, logos = [] } = Astro.props;
---

<section class="py-16 border-t border-border">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    {title && (
      <p class="text-center text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-10">
        {title}
      </p>
    )}
    {logos.length > 0 && (
      <ul class="grid grid-cols-2 items-center gap-8 sm:grid-cols-3 lg:grid-cols-6">
        {logos.map((logo) => (
          <li class="flex items-center justify-center">
            {logo.image ? (
              <img
                src={logo.image}
                alt={logo.name || ""}
                class="h-8 w-auto max-w-full object-contain opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0"
              />
            ) : (
              <span class="text-sm font-semibold text-muted-foreground">
                {logo.name}
              </span>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

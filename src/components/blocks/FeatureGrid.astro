---
/*
  Feature grid block. Title + intro on top, 3 or 4 column grid of icon
  + title + body items below. Mirrors the homepage services section
  visually but runs on content typed directly into this block.
*/
import SectionHeading from "../SectionHeading.astro";

interface Item {
  icon?: string;
  title?: string;
  body?: string;
}

interface Props {
  title?: string;
  intro?: string;
  columns?: "3" | "4";
  items?: Item[];
}

const { title, intro, columns = "3", items = [] } = Astro.props;

const gridClass =
  columns === "4"
    ? "sm:grid-cols-2 lg:grid-cols-4"
    : "sm:grid-cols-2 lg:grid-cols-3";
---

<section class="py-16 sm:py-20 border-t border-border">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    {(title || intro) && (
      <SectionHeading
        title={title || ""}
        description={intro || ""}
        align="center"
      />
    )}
    {items.length > 0 && (
      <div class={`mt-12 grid grid-cols-1 gap-6 ${gridClass}`}>
        {items.map((item) => (
          <div
            class="bg-background border border-border p-6"
            style="border-radius: var(--radius-md)"
          >
            {item.icon && (
              <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
                {item.icon}
              </p>
            )}
            {item.title && (
              <h3 class="text-lg font-semibold text-foreground">{item.title}</h3>
            )}
            {item.body && (
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed whitespace-pre-line">
                {item.body}
              </p>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</section>

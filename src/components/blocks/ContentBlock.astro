---
/*
  Long-form text block. Keystatic's conditional discriminant doesn't allow
  a markdoc field inside, so this block uses a multiline text field and
  splits paragraphs on blank lines. Good enough for intros, legal copy,
  and essay-style pages. For richer content, use a full Keystatic markdoc
  field on a dedicated collection entry.

  TODO (member extensions): Upgrade to proper markdown/rich text. Two routes:
  (1) Run the `body` string through a lightweight markdown parser (marked,
  markdown-it) so ## headings, **bold**, [links], and lists render.
  (2) Add a dedicated "longform" collection with `fields.markdoc` and teach
  the page builder to pull an entry by slug instead of inlining prose here.
*/
interface Props {
  body?: string;
}

const { body = "" } = Astro.props;

const paragraphs = body
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

{paragraphs.length > 0 && (
  <section class="py-16 sm:py-20 border-t border-border">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <div class="prose prose-lg max-w-none prose-headings:font-semibold prose-headings:text-foreground prose-p:text-foreground prose-a:text-primary prose-strong:text-foreground">
        {paragraphs.map((p) => (
          <p class="text-base sm:text-lg text-foreground leading-relaxed whitespace-pre-line mb-6">
            {p}
          </p>
        ))}
      </div>
    </div>
  </section>
)}

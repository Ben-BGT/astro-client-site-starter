---
interface Props {
  name: string;
  description?: string;
  href: string;
  image?: string;
  variant?: "default" | "muted";
}

const { name, description, href, image, variant = "default" } = Astro.props;
const bg = variant === "muted" ? "bg-muted" : "bg-background";
---

<a href={href} class={`group block ${bg} border border-border p-6 hover:border-primary transition-colors`}>
  {image && <img src={image} alt={name} class="w-full h-40 object-cover mb-4" />}
  <h3 class="text-lg font-semibold text-foreground group-hover:text-primary">{name}</h3>
  {description && <p class="mt-2 text-sm text-muted-foreground">{description}</p>}
</a>

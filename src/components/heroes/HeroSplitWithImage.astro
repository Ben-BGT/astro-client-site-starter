---
/*
  Split-with-image hero. Text left, image right on desktop;
  image above text on mobile.
  Good for product businesses, services where showing the
  deliverable matters, and personal brands.
*/
interface Props {
  overline?: string;
  headline: string;
  subhead?: string;
  ctaText?: string;
  ctaUrl?: string;
  heroImage?: string | null;
  imageAlt?: string;
}

const { overline, headline, subhead, ctaText, ctaUrl, heroImage, imageAlt = "" } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border">
  <div class="relative mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="order-2 lg:order-1">
        {overline && (
          <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-4">{overline}</p>
        )}
        <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl lg:text-6xl leading-tight">
          {headline}
        </h1>
        {subhead && (
          <p class="mt-6 text-lg text-muted-foreground max-w-2xl whitespace-pre-line">{subhead}</p>
        )}
        <div class="mt-10 flex flex-col sm:flex-row items-start gap-4">
          {ctaText && ctaUrl && (
            <a
              href={ctaUrl}
              class="inline-flex items-center justify-center bg-primary px-6 py-3 text-base font-semibold text-primary-foreground hover:bg-primary-hover transition-colors w-full sm:w-auto"
              style="border-radius: var(--radius-md)"
            >
              {ctaText}
            </a>
          )}
          <a
            href="/contact"
            class="inline-flex items-center justify-center border border-border px-6 py-3 text-base font-semibold text-foreground hover:border-primary transition-colors w-full sm:w-auto"
            style="border-radius: var(--radius-md)"
          >
            Get in touch
          </a>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        {heroImage ? (
          <img
            src={heroImage}
            alt={imageAlt}
            class="w-full h-auto object-cover border border-border"
            style="border-radius: var(--radius-md)"
          />
        ) : (
          <div
            class="w-full aspect-[4/3] bg-muted border border-border flex items-center justify-center"
            style="border-radius: var(--radius-md)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
              <circle cx="9" cy="9" r="2"/>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
            </svg>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

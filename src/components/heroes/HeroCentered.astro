---
/*
  Centered hero. Text stacked and centered, CTAs below.
  Good for landing pages, single-product sites, and brands
  that want a calmer, more balanced first impression.
*/
interface Props {
  overline?: string;
  headline: string;
  subhead?: string;
  ctaText?: string;
  ctaUrl?: string;
}

const { overline, headline, subhead, ctaText, ctaUrl } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border">
  <div class="relative mx-auto max-w-5xl px-6 py-20 sm:py-24 lg:px-8 lg:py-28 text-center">
    {overline && (
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-4">{overline}</p>
    )}
    <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl lg:text-6xl leading-tight">
      {headline}
    </h1>
    {subhead && (
      <p class="mt-6 text-lg text-muted-foreground max-w-2xl mx-auto whitespace-pre-line">{subhead}</p>
    )}
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      {ctaText && ctaUrl && (
        <a
          href={ctaUrl}
          class="inline-flex items-center justify-center bg-primary px-6 py-3 text-base font-semibold text-primary-foreground hover:bg-primary-hover transition-colors w-full sm:w-auto"
          style="border-radius: var(--radius-md)"
        >
          {ctaText}
        </a>
      )}
      <a
        href="/contact"
        class="inline-flex items-center justify-center border border-border px-6 py-3 text-base font-semibold text-foreground hover:border-primary transition-colors w-full sm:w-auto"
        style="border-radius: var(--radius-md)"
      >
        Get in touch
      </a>
    </div>
  </div>
</section>

---
/*
  Header dispatcher. Reads siteSettings.design.headerVariant and
  renders the matching variant. Variants live in ./headers/*.astro.
  Kept as a single entry point so Layout.astro can stay clean.
*/
import { reader } from "../lib/keystatic";
import HeaderMinimal from "./headers/HeaderMinimal.astro";
import HeaderCentered from "./headers/HeaderCentered.astro";
import HeaderSplit from "./headers/HeaderSplit.astro";

const settings = await reader.singletons.siteSettings.read();
const variant = settings?.design?.headerVariant || "minimal";
---

{variant === "centered" && <HeaderCentered />}
{variant === "split" && <HeaderSplit />}
{(variant !== "centered" && variant !== "split") && <HeaderMinimal />}

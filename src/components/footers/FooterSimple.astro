---
/*
  Simple footer. One row: brand mark, copyright, quick links & social.
  v0.2.0 default. Good for most business sites.
*/
import { reader } from "../../lib/keystatic";

const settings = await reader.singletons.siteSettings.read();
const siteName = settings?.siteName || "Your Site";
const footerText = settings?.footerText || "Your Company.";
const socialLinks = settings?.socialLinks || [];
const year = new Date().getFullYear();
---

<footer class="border-t border-border/40 bg-background py-12">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <div class="flex items-center gap-2">
        <img src="/favicon.svg" alt={siteName} width="20" height="20" class="h-5 w-5" />
        <span class="text-sm font-medium text-foreground">{siteName}</span>
      </div>
      <p class="text-sm text-muted-foreground">&copy; {year} {footerText}</p>
      <div class="flex gap-6 text-sm text-muted-foreground">
        <a href="/services" class="hover:text-primary">Services</a>
        <a href="/blog" class="hover:text-primary">Blog</a>
        <a href="/contact" class="hover:text-primary">Contact</a>
        {socialLinks.map((link) => (
          <a href={link.url} class="hover:text-primary" target="_blank" rel="noopener noreferrer">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
